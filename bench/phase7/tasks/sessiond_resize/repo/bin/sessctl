#!/usr/bin/env python3
"""Client for sessiond (127.0.0.1:7070): sessctl [--port P] COMMAND [ARGS]

    sessctl stats | ping | get TOKEN | login USER | logout TOKEN | resize BUCKETS
"""
import socket
import sys

args = sys.argv[1:]
port = 7070
if args[:1] == ["--port"]:
    port, args = int(args[1]), args[2:]
if not args or args[0] in ("-h", "--help", "help"):
    print(__doc__.strip())
    sys.exit(0)
with socket.create_connection(("127.0.0.1", port), timeout=30) as s:
    s.sendall((" ".join(args) + "\n").encode())
    reply = s.makefile().readline().strip()
print(reply)
sys.exit(0 if reply.startswith("OK") else 1)
